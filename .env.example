# GitHub Actions Secrets — add these in:
# https://github.com/ocakdans/qa_intelligence/settings/secrets/actions

# Anthropic / Claude
ANTHROPIC_API_KEY=sk-ant-...

# Jira (used only for the task link in Slack)
JIRA_BASE_URL=https://selimocakdan.atlassian.net
JIRA_EMAIL=selim.ocakdan@gmail.com
JIRA_API_TOKEN=           # https://id.atlassian.com/manage-profile/security/api-tokens

# Qase
QASE_API_TOKEN=            # https://app.qase.io/user/api/token
QASE_PROJECT_CODE=QI       # Project code in Qase (e.g. QI)

# Slack
SLACK_BOT_TOKEN=xoxb-...  # Bot token from your Slack App
SLACK_CHANNEL_ID=C...      # Channel ID (right-click channel → Copy link → last segment)

# Cloudflare Worker Secrets (set via `wrangler secret put`)
SLACK_SIGNING_SECRET=...   # From Slack App → Basic Information → Signing Secret
GITHUB_TOKEN=ghp_...       # Fine-grained PAT with "Contents: Read & Write" + "Actions: Write" on this repo
GITHUB_REPO=ocakdans/qa_intelligence
